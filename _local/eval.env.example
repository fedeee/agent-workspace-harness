# Copy to eval.env (gitignored). Used by /mount-s3-db.
# Pass a full s3:// URI instead if you do not want these defaults.

# S3 bucket that stores pg_dump files.
# Object layout expected by the mount skill:
#   s3://$EVAL_BACKUP_BUCKET/db/<latest|timestamp>/$EVAL_DB_NAME.dump
EVAL_BACKUP_BUCKET=your-backup-bucket
AWS_REGION=eu-central-1
AWS_PROFILE=default

# Database name, user, and password inside the dump.
# The sidecar Postgres uses the same values so pg_restore can land.
EVAL_DB_NAME=app
EVAL_DB_USER=app
EVAL_DB_PASS=app

# Host ports the sidecar must never use (live local Postgres).
EVAL_FORBIDDEN_PORTS=5432,5433
